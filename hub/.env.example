# Copy to .env and fill in. .env is gitignored; never commit real tokens.

# OIDC issuer that signs the access tokens (Pocket ID), exactly as its discovery
# document advertises it: no trailing slash for Pocket ID.
OIDC_ISSUER=https://id.example.com

# Public URL of the hub's MCP endpoint. Advertised as the RFC 8707 resource and
# must match the API registered in Pocket ID (Administration -> APIs).
MCP_PUBLIC_URL=https://mcp.example.com/mcp

# Accepted token audiences, comma separated. Normally just the resource URL above.
OAUTH_AUDIENCE=https://mcp.example.com/mcp

# Scopes advertised to MCP clients. `groups` is required for section access.
# OAUTH_SCOPES=openid profile email groups offline_access

# Which identity-provider groups may use which section (see access-policy.example.json).
ACCESS_POLICY_FILE=./access-policy.json

# netbird module: enabled when NETBIRD_API_TOKEN is set.
NETBIRD_API_TOKEN=
# NETBIRD_API_URL=https://netbird.example.com

# Listen address. Defaults shown.
# HOST=0.0.0.0
# PORT=8080
