{
  "name": "mcp-hub",
  "version": "0.4.0",
  "private": true,
  "description": "Self-hosted MCP hub: one endpoint and one Pocket ID login, sections gated by identity-provider groups",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test \"dist/**/*.test.js\"",
    "check": "pnpm typecheck && pnpm test",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jose": "^6.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@12.16.1"
}
