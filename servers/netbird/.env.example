# Copy to .env and fill in. .env is gitignored; never commit real tokens.

# OIDC issuer that signs the access tokens (Pocket ID), exactly as its discovery
# document advertises it: no trailing slash for Pocket ID.
OIDC_ISSUER=https://id.example.com

# Public URL of this MCP endpoint. Advertised as the RFC 8707 resource and must
# match the API registered in Pocket ID (Administration -> APIs).
MCP_PUBLIC_URL=https://mcp-netbird.example.com/mcp

# Accepted token audiences, comma separated. Normally just the resource URL
# above: MCP clients request tokens with resource=<MCP_PUBLIC_URL>, so Pocket ID
# stamps that as the audience. Add the OAuth client ID only for clients that log
# in without the RFC 8707 resource parameter.
OAUTH_AUDIENCE=https://mcp-netbird.example.com/mcp

# Scopes advertised to MCP clients (space separated). Default shown.
# OAUTH_SCOPES=openid profile email offline_access

# NetBird Personal Access Token (dashboard -> your user -> Access Tokens).
NETBIRD_API_TOKEN=

# Self-hosted only. Omit to use NetBird cloud (https://api.netbird.io).
# NETBIRD_API_URL=https://netbird.example.com

# Listen address. Defaults shown.
# HOST=0.0.0.0
# PORT=8080
